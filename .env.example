# Service configuration
NODE_ENV=development
GOV_LOG_LEVEL=INFO
GOV_SERVICE_NAME=frontend
PORT=3000
FRONTEND_APP_NAME=Bluejay

# Internal service URLs
AUTHENTICATOR_SERVICE_URL=http://localhost:5900
SCOPE_SERVICE_URL=http://localhost:5901
REGISTRY_SERVICE_URL=http://localhost:5902
REPORTER_SERVICE_URL=http://localhost:5905

# Cookie settings (max ages in seconds)
AUTH_ACCESS_COOKIE_NAME=governify_next_access_token
AUTH_REFRESH_COOKIE_NAME=governify_next_refresh_token
ACCESS_TOKEN_MAX_AGE=900
REFRESH_TOKEN_MAX_AGE=604800
